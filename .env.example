# Copy this file to .env and adjust as needed:  cp .env.example .env

# SQLite database location (resolved relative to the project root at runtime).
DATABASE_URL="file:./dev.db"

# Secret used to sign session JWTs. Generate a strong value for any real deploy:
#   openssl rand -base64 48
AUTH_SECRET="change-me-to-a-long-random-string"
